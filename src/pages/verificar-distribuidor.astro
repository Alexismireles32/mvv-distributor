import { WhatsAppProvider } from '../components/home-wrapper.jsx';
import { DistributorVerificationSystem } from '../components/distributor-verification.jsx';
import { Footer2 } from '../components/footer-02.jsx';
---

<Layout 
  title="Verificar Distribuidor | MVV Natural"
