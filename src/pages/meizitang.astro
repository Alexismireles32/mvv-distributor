---
import Layout from '../layouts/Layout.astro';
import { Navbar6 } from '../components/navbar-06.jsx';
import { WhatsAppProvider } from '../components/home-wrapper.jsx';
import { CartProvider } from '../components/customer-cart.jsx';
import { ProductPageWrapperEnhanced } from '../components/product-page-wrapper-enhanced.jsx';
import { Footer2 } from '../components/footer-02.jsx';

const productData = {
  productName: "Meizitang Soft Gel",
  productImage: "https://res.cloudinary.com/dsulhqvza/image/upload/f_auto,q_auto,w_1200/v1761549584/catalogo-mvv-natural-35_ao2pay.webp",
  productUrl: "/meizitang",
  description: "Meizitang Soft Gel (Botanical Slimming) es 100% natural soft gel. Descubre el secreto para alcanzar tu peso ideal. Reduce la grasa por endógenos, disminuye la absorción de colesterol y grasas, elimina radicales libres en el cuerpo, acelera el metabolismo, limpia el sistema digestivo y desintoxica el organismo.",
  benefits: [
    "100% natural soft gel",
    "Secreto para alcanzar tu peso ideal",
    "Reduce grasa por endógenos",
    "Disminuye absorción de colesterol y grasas",
    "Elimina radicales libres",
    "Acelera el metabolismo",
    "Limpia sistema digestivo",
    "Desintoxica el organismo"
  ],
  ingredients: [
    "Kolajagar - Digestión y limpieza",
    "Goma - Fibra natural",
    "Hoja de Loto - Antioxidante",
    "Gardenia - Metabolismo",
    "Atractylodes - Digestión",
    "Plátano Oriental de Agua - Detox",
    "Semilla de Cassia - Control de apetito",
    "Raíz de Kutzu - Balance digestivo",
    "Rizoma Alismatis - Diurético"
  ],
  usage: "1 cápsula en ayunas, 20 minutos antes de los alimentos. Presentación de 36 cápsulas. Para mejores resultados, usar consistentemente durante al menos 30 días. Beber abundante agua durante el día.",
  warnings: "No apto para hipertensos, diabéticos ni para mujeres lactando o embarazadas."
};
---

<Layout 
  title="Meizitang Soft Gel - Botanical Slimming 100% Natural | MVV Natural"
  description="Meizitang Soft Gel: 100% natural soft gel. Reduce grasa, disminuye colesterol, elimina radicales libres, acelera metabolismo, limpia digestivo. 36 cápsulas."
>
  <CartProvider client:load>
    <WhatsAppProvider client:load>
      <Navbar6 client:load />
      <ProductPageWrapperEnhanced client:load productData={productData} />
      <Footer2 client:idle />
    </WhatsAppProvider>
  </CartProvider>
</Layout>

