---
import Layout from '../layouts/Layout.astro';

// Import with the ACTUAL filenames (lowercase with dashes)
import { Navbar6 } from '../components/navbar-06.jsx';
import { WhatsAppProvider } from '../components/home-wrapper.jsx';
import { Faq7 } from '../components/faq-07.jsx';
import { Footer2 } from '../components/footer-02.jsx';
---

<Layout 
  title="¿Funcionan Las Pastillas Para Bajar de Peso? Preguntas Frecuentes"
  description="Todas tus dudas respondidas: ¿Cuánto peso voy a perder? ¿Son seguras las pastillas naturales? ¿Cuánto tarda el envío a México? Respuestas honestas sin vueltas."
>
  <WhatsAppProvider client:load>
    <Navbar6 client:load />
    <Faq7 client:idle />
    <Footer2 client:idle />
  </WhatsAppProvider>
</Layout>

