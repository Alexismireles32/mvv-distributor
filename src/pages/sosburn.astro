---
import Layout from '../layouts/Layout.astro';
import { Navbar6 } from '../components/navbar-06.jsx';
import { WhatsAppProvider } from '../components/home-wrapper.jsx';
import { CartProvider } from '../components/customer-cart.jsx';
import { ProductPageWrapperEnhanced } from '../components/product-page-wrapper-enhanced.jsx';
import { Footer2 } from '../components/footer-02.jsx';

const productData = {
  productName: "SOS Burn",
  productImage: "https://res.cloudinary.com/dsulhqvza/image/upload/f_auto,q_auto,w_1200/v1761575596/sosburn_g2ui2b.png",
  productUrl: "/sosburn",
  description: "SOS Burn quita ansiedad y baja de peso. Quema grasa, inhibe el apetito y brinda energía. Resultados en 15 días. Gracias a sus ingredientes perfectamente diseñados logras la pérdida de peso contundente y eliminar esa grasa difícil de tu cuerpo. SOS BURN ayuda a inhibir el apetito y provocar sensación de saciedad. Acelera el metabolismo 5x, reduce colesterol y triglicéridos. Aporta gran cantidad de energía mejorando el rendimiento físico y mental y por lo tanto combatir la fatiga y el estrés. Combate la flacidez ya que sus componentes ayudan a generar músculo magro logrando bajar de peso y tonificar a la vez. Logra resultados en los primeros 15 días comenzando por el vientre, pierde tallas y kilos de grasa. Lograrás mantener un balance en tu digestión ya que no causa estreñimiento pero no laxa. Ingredientes: acetil-L-carnitina, extracto de semilla de griffonia, simpirolita 5-HTP, inositol, cromo, vitamina B6. Para él y para ella. 30 cápsulas.",
  benefits: [
    "Quita ansiedad y baja de peso efectivamente",
    "Pérdida de peso contundente y elimina grasa difícil",
    "Inhibe el apetito y provoca sensación de saciedad",
    "Aporta gran cantidad de energía mejorando rendimiento físico y mental",
    "Combate la fatiga y el estrés",
    "Combate la flacidez generando músculo magro",
    "Resultados en primeros 15 días comenzando por vientre",
    "Agiliza hasta 5 veces tu metabolismo"
  ],
  ingredients: [
    "Acetil-L-Carnitina - Quema grasa y energía",
    "Extracto de Semilla de Griffonia - Control de apetito",
    "Simplicifolia 5-HTP - Serotonina y ánimo",
    "Cissus Quadrangularis Extract - Metabolismo y energía",
    "Rhodolia Rosea Root Powder - Energía y resistencia",
    "L-Teanina - Enfoque mental",
    "Infinergy (Di-Cafeína Malato) - Energía sostenida"
  ],
  howToUse: "Toma 1 cápsula diaria en ayunas y disfruta tu día. Beber abundante agua durante el día. Para mejores resultados combinar con alimentación balanceada. Logra resultados en primeros 15 días comenzando por vientre. No consumir en periodo de embarazo o lactancia. 30 cápsulas para él y para ella."
};
---

<Layout 
  title="S&S BURN Quita Ansiedad y Baja de Peso | 5x Metabolismo | 30 Cápsulas"
  description="S&S BURN quita ansiedad, baja de peso, pérdida contundente, elimina grasa difícil. 5x metabolismo. Para él y para ella. 30 cápsulas."
>
  <CartProvider client:load>
    <WhatsAppProvider client:load>
      <Navbar6 client:load />
      <ProductPageWrapperEnhanced client:load productData={productData} />
      <Footer2 client:idle />
    </WhatsAppProvider>
  </CartProvider>
</Layout>
