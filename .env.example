# Copy to .env and fill in. Restart `npm run dev` after changing.
#
# None of these use the PUBLIC_ prefix, so Astro does NOT inline them into the client
# bundle — they exist only inside the serverless API routes. That is the point of the
# Neon migration: the browser no longer holds any database credential.
# Adding a PUBLIC_ prefix to any of these would leak it to every visitor.

# Neon Postgres connection string.
# Vercel dashboard -> Storage -> Neon -> Connect, or `vercel env pull` after linking.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Signs the session cookie. Use a different value in production than locally.
#   openssl rand -hex 32
SESSION_SECRET=

# Gate for the distributor registration form, checked server-side.
REGISTRATION_CODE=

# Created automatically by the Vercel Blob integration. Required for profile photos.
BLOB_READ_WRITE_TOKEN=
